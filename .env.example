#
# Copy to .env and adjust. Never commit .env.

# Core, as reachable from inside the edge container (core's compose service).
EDGE_UPSTREAM=http://app:8080

# Shared with core's MOSAICAST_EDGE_TOKEN, so core's admin page can show the edge as connected.
# Generate one: openssl rand -hex 24
EDGE_CORE_TOKEN=

# Public origin for share previews and the calendar entry. Empty = from X-Forwarded-Proto/-Host.
EDGE_PUBLIC_URL=

# Time zone for dates shown to visitors without JavaScript (with JavaScript: the visitor's own).
EDGE_TIMEZONE=Europe/Berlin

# How often the edge asks core for the policy (304 when nothing changed).
EDGE_POLL_INTERVAL=2s

# The theme (docs/THEMING.md, "Deploying a theme"). Set at most one of EDGE_THEME_PATH and EDGE_THEME;
# neither = the edge's default look.
#
# A theme folder (or a theme.tgz from pack-theme) on the host, mounted read-only:
EDGE_THEME_PATH=
#
# Or a theme the edge fetches at startup and keeps in its cache volume, pinned by its sha256:
#   EDGE_THEME=Mosaicast/mosaicast-edge-theme-example@v1.0.0#sha256:<digest>
#   EDGE_THEME=https://example.org/theme.tgz#sha256:<digest>
# Always name the tag with a pin (owner/repo alone means "latest release", which a new release breaks).
EDGE_THEME=
# For a private theme repo: a fine-grained GitHub token for that one repository, Contents: read-only,
# with an expiry. When it expires the cached theme keeps working; a new release (new pin) needs a new one.
EDGE_THEME_TOKEN=
# Download without a pin. Leave false: a theme's scripts run on the site for every visitor.
EDGE_THEME_ALLOW_UNVERIFIED=false

# Host port the TLS terminator proxies the public domain to. Loopback only.
EDGE_BIND=127.0.0.1
EDGE_PORT=8082

# Core's compose network (docker network ls).
CORE_NETWORK=mosaicast-core_default
