#
# Run the Go toolchain from Docker (no local Go needed).
#   dev/go test ./...    dev/go vet ./...    dev/go fmt ./...
exec docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -e GOCACHE=/tmp/go-cache -e GOFLAGS=-buildvcs=false \
  -e GOTOOLCHAIN=local -v mosaicast-edge-go-cache:/tmp/go-cache -v "$PWD":/src -w /src golang:1.27-bookworm go "$@"
